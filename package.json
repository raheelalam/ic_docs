{
  "name": "documentation",
  "description": "Source code for InCountry Documentation website.",
  "homepage": "https://github.com/incountry/documentation#readme",
  "version": "2.1.0",
  "private": true,
  "author": "InCountry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incountry/documentation.git"
  },
  "bugs": {
    "url": "https://github.com/incountry/documentation/issues"
  },
  "keywords": [
    "incountry-documentation"
  ],
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "convert-images": "node convert-images.js",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "dev": "run-p convert-images webpack-watch start",
    "docusaurus-build": "run-p webpack-build build",
    "prepare": "husky",
    "lint": "npm run lint:css",
    "lint:css": "npx stylelint src/**/*.css",
    "format": "prettier --write '**/*.{js,ts,tsx,css,scss,json}'",
    "format:check": "prettier --check '**/*.{js,ts,tsx,css,scss,json}'",
    "webpack-build": "webpack --mode=production",
    "webpack-watch": "webpack --mode=production -w"
  },
  "dependencies": {
    "@docusaurus/core": "3.7.0",
    "@docusaurus/plugin-google-tag-manager": "3.7.0",
    "@docusaurus/preset-classic": "3.7.0",
    "@docusaurus/theme-mermaid": "3.7.0",
    "@mdx-js/react": "3.1.0",
    "check-http-status": "1.3.0",
    "clsx": "2.1.1",
    "detect-external-link": "2.0.1",
    "docusaurus-plugin-html-cleanup": "1.0.0",
    "prism-react-renderer": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.7.0",
    "@docusaurus/tsconfig": "3.7.0",
    "@docusaurus/types": "3.7.0",
    "@eslint/js": "9.25.1",
    "eslint": "9.25.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-webpack-plugin": "5.0.1",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.1",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.3",
    "prettier-eslint": "16.4.1",
    "run-p": "0.0.0",
    "stylelint": "16.19.0",
    "stylelint-config-standard": "38.0.0",
    "typescript": "5.8.3",
    "webpack": "5.99.7",
    "webpack-cli": "6.0.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,css,scss,json}": "prettier --write --ignore-unknown"
  }
}
